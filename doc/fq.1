\f(CR\fBhtml\fP\fP
.RS 4
HyperText Markup Language
.sp
HTML is decoded in HTML5 mode and will always include \f(CR<html>\fP, \f(CR<body>\fP and \f(CR<head>\fP elements.
See xml format for more examples and how to preserve element order and how to encode to xml.
There is no \f(CRto_html\fP function, see \f(CRto_xml\fP instead.
.sp
Element as object
.RS 4
.RE
.sp
.if n .RS 4
.nf
.fam C
# decode as object is the default
$ echo \*(Aq<a href="url">text</a>\*(Aq | fq \-d html
{
  "html": {
    "body": {
      "a": {
        "#text": "text",
        "@href": "url"
      }
    },
    "head": ""
  }
}
.fam
.fi
.if n .RE
.sp
Element as array
.RS 4
.RE
.sp
.if n .RS 4
.nf
.fam C
$ echo \*(Aq<a href="url">text</a>\*(Aq | fq \-d html \-o array=true
[
  "html",
  null,
  [
    [
      "head",
      null,
      []
    ],
    [
      "body",
      null,
      [
        [
          "a",
          {
            "#text": "text",
            "href": "url"
          },
          []
        ]
      ]
    ]
  ]
]

# decode html files to a {file: "title", ...} object
$ fq \-n \-d html \*(Aq[inputs | {key: input_filename, value: .html.head.title?}] | from_entries\*(Aq *.html

# <a> href:s in file
$ fq \-r \-o array=true \-d html \*(Aq.. | select(.[0] == "a" and .[1].href)?.[1].href\*(Aq file.html
.fam
.fi
